#!/bin/sh
# The command list in the README is written from the help texts and never by hand, so a change to
# one of them has to reach the other in the same commit. Regenerating here rather than only checking
# means the two cannot be committed out of step, and the run is skipped entirely when neither file
# is part of the commit.
#
# Install once with:  git config core.hooksPath .githooks

staged=$(git diff --cached --name-only)
case "$staged" in
    *src/message_printer.rs*|*README.md*) ;;
    *) exit 0 ;;
esac

echo "pre-commit: writing the README command list from the help texts"
# Compiles the staged source rather than trusting whatever binary happens to be lying in target/
if ! MEZURA_UPDATE_GOLDEN=1 cargo test -p mezura readme --quiet; then
    echo "pre-commit: the README could not be regenerated, commit aborted" >&2
    exit 1
fi

if ! git diff --quiet README.md; then
    git add README.md
    echo "pre-commit: the README command list was out of date and has been added to this commit"
fi
