# Copy to benchmark.conf (that exact name, beside benchmark.py) and point these at
# wherever you keep them on THIS machine. There are no defaults on purpose.
# A flag beats an environment variable, which beats this file.

tools  = <directory holding the mezura, scc and tokei binaries>
corpus = <the checkout that gets counted>
